---
import "../styles/global.css";
---

<html lang="ja">
    <head>
        <meta charset="utf-8" />
        <title>外部リンク</title>
    </head>
    <body class="bg-base-100 min-h-screen">
        <main class="container mx-auto px-4 py-8">
            <div class="card bg-base-200 shadow-xl max-w-2xl mx-auto">
                <div class="card-body">
                    <h1 class="card-title text-3xl mb-4">外部リンク</h1>
                    <ul class="space-y-4">
                        <li>
                            <a
                                href="https://github.com/yourname"
                                class="btn btn-outline w-full justify-start"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <span class="mr-2">🐙</span>GitHub
                            </a>
                        </li>
                        <li>
                            <a
                                href="https://twitter.com/yourname"
                                class="btn btn-outline w-full justify-start"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <span class="mr-2">𝕏</span>Twitter(X)
                            </a>
                        </li>
                        <li>
                            <a
                                href="https://zenn.dev/yourname"
                                class="btn btn-outline w-full justify-start"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <span class="mr-2">📘</span>Zenn
                            </a>
                        </li>
                        <li>
                            <a
                                href="mailto:sample@example.com"
                                class="btn btn-outline w-full justify-start"
                            >
                                <span class="mr-2">✉️</span>Email
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="mt-8 text-center">
                <a href="/" class="btn btn-outline">← トップへ戻る</a>
            </div>
        </main>
    </body>
</html>
