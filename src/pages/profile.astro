---
import "../styles/global.css";
---

<html lang="ja">
    <head>
        <meta charset="utf-8" />
        <title>プロフィール</title>
    </head>
    <body class="bg-base-100 min-h-screen">
        <main class="container mx-auto px-4 py-8">
            <div class="card bg-base-200 shadow-xl max-w-2xl mx-auto">
                <div class="card-body">
                    <h1 class="card-title text-3xl mb-2">山田 太郎</h1>
                    <p class="text-base-content/60 mb-4">
                        フロントエンドエンジニア / Webクリエイター
                    </p>
                    <p class="mb-4">
                        Astro・Tailwind
                        CSS・DaisyUIを活用したモダンなWebサイト制作が得意です。UI/UX設計から実装まで幅広く対応します。
                    </p>
                    <div class="mb-4">
                        <span class="badge badge-primary mr-2">Astro</span>
                        <span class="badge badge-secondary mr-2"
                            >Tailwind CSS</span
                        >
                        <span class="badge badge-accent mr-2">DaisyUI</span>
                        <span class="badge badge-outline">TypeScript</span>
                    </div>
                    <div class="mt-4">
                        <span class="font-bold">連絡先：</span>
                        <a
                            href="mailto:sample@example.com"
                            class="link link-primary">sample@example.com</a
                        >
                    </div>
                </div>
            </div>
            <div class="mt-8 text-center">
                <a href="/" class="btn btn-outline">← トップへ戻る</a>
            </div>
        </main>
    </body>
</html>
